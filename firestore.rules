rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'digitaltimesbhiwandi@gmail.com' && 
        request.auth.token.email_verified == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBooking(data) {
      return data.userId is string && 
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.userEmail is string && data.userEmail.size() <= 100 &&
             data.weddingDate is string &&
             data.packageName in ['Classic', 'Premium', 'Royal'] &&
             data.status in ['pending', 'confirmed', 'cancelled'] &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow create: if isSignedIn() && isValidBooking(incoming());
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) && 
         incoming().status == 'cancelled' &&
         incoming().updatedAt == request.time) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
